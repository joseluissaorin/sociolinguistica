{
  "name": "sociolinguistica",
  "account_id": "f22c7a728ddc8e41cefd2644f8fb7632",
  "main": "src/index.js",
  "routes": [{ "pattern": "sociolinguistica.joseluissaorin.com", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/f/*", "/api/*"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "sociolinguistica" }],
  "ratelimits": [
    { "name": "LIMITE_WHISPER", "namespace_id": "4101", "simple": { "limit": 12, "period": 60 } },
    { "name": "LIMITE_JEV", "namespace_id": "4102", "simple": { "limit": 40, "period": 60 } }
  ],
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true }
}
